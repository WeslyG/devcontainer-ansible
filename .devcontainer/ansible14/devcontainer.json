  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.ansible",
        "blauwelucht.ansible-go-to-definition",
        "ikbengeenrobot.ansible-variable-lookup",
        "samuelcolvin.jinjahtml",
        "oderwat.indent-rainbow",
